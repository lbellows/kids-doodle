{
  "expo": {
    "name": "KidsDoodle",
    "slug": "kids-doodle",
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "kidsdoodle",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF8EC",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.kidsdoodle.app",
      "predictiveBackGestureEnabled": false,
      "versionCode": 6,
      "blockedPermissions": [
        "android.permission.VIBRATE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-navigation-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain"
        }
      ],
      "./plugins/withReleaseSigning",
      "./plugins/withOfflineReleaseManifest",
      "./plugins/withoutUpdatesMetadata",
      "./plugins/withGradleMemory",
      "./plugins/withAbiSplits",
      "./plugins/withMinifiedRelease",
      "./plugins/withCompressedNativeLibs",
      "./plugins/withoutDependencyMetadata"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
